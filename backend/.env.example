PORT=3001
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://brewlite:CONGNGHEPHANMEM12345@localhost:5433/brewlite?schema=public
DIRECT_URL=postgresql://brewlite:CONGNGHEPHANMEM12345@localhost:5433/brewlite?schema=public
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN_SECONDS=604800
NODE_ENV=development

# VNPay Sandbox requires your registered test merchant. Never put its secret in frontend.
PAYMENT_PROVIDER=vnpay
PAYMENT_MOCK_ALLOW_OVERRIDE=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:3001/payments/vnpay/return
# Configure https://your-public-api/payments/vnpay/ipn in the VNPay merchant portal.
# Public server IP for QueryDR, if required by your merchant configuration.
VNPAY_QUERY_IP=127.0.0.1
# Set only behind a known trusted proxy, e.g. 1 for one reverse proxy hop.
# TRUST_PROXY_HOPS=1

# Explicitly allow the classroom mock gateway in a production Docker build.
PAYMENT_ALLOW_MOCK_IN_PRODUCTION=false
